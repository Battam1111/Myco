# Myco v0.9 substrate — .gitignore

# Rust build artifacts
target/
**/*.rs.bk
# Note: workspace-level Cargo.lock IS checked in (this workspace contains binaries:
# myco-substrate + anchor-surface-host). Per Cargo convention binaries pin their
# dependency tree. Sub-crate Cargo.lock files (if any are produced) are ignored
# below — only the root lockfile is authoritative.
**/[Cc]rate-specific-Cargo.lock

# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
build/
dist/
.cache/
.coverage
coverage.xml

# Node / TypeScript (for anchor/client + operators/<ts host>)
node_modules/
*.tsbuildinfo
.next/
.nuxt/

# IDE / editor — local-user settings (per-developer; not committed)
.idea/
.vscode/
.claude/
*.swp
*.swo
.DS_Store

# Substrate runtime state (when v0.9 substrates run, these dirs hold their state — never commit substrate state)
# Each substrate has its own state directory under a configurable path; this catches the conventional one.
.substrate/
substrate_state/
.myco_state/

# Ceremony per-invocation logs — operator-side ephemeral artifacts.
# Each successful run writes `<mode>_<timestamp>.json`; archive locally if you
# need the production receipt, but don't commit (it would create per-machine
# drift). The canonical record is the on-chain DAG event + the committed manifest.
operators/claude/ceremonies/*/ceremony_log/

# Local inhabitation config (machine-specific paths + production-substrate pointer) - never commit
.mcp.json
